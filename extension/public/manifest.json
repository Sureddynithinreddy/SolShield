{
  "manifest_version": 3,
  "name": "SolShield — Solana Transaction Firewall",
  "version": "1.0.0",
  "description": "Reads and risk-scores every Solana transaction before it reaches your wallet. Non-custodial.",
  "action": {
    "default_title": "SolShield",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js", "overlay.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8787/*", "https://*/*"]
}
