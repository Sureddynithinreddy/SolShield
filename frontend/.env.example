# SolShield — environment template. Copy to `.env` and fill in as needed.
#
# Optional dedicated Solana RPC endpoint (avoids public rate limits).
# Leave blank to use the public endpoint (https://api.mainnet-beta.solana.com).
# Must start with VITE_ so Vite exposes it to the browser.
VITE_SOLANA_RPC=

# Which cluster the RPC points at: mainnet-beta | devnet | testnet.
VITE_SOLANA_CLUSTER=

# SolShield backend scanning service URL. Blank = local in-browser scanner only.
VITE_API_URL=
