# SolShield backend — environment template. Copy to `.env`.

# Comma-separated RPC endpoints (failover in order). Falls back to public mainnet.
SOLANA_RPC_URLS=

# Server
PORT=8787
HOST=0.0.0.0

# Comma-separated allowed CORS origins, or * for all (dev).
CORS_ORIGINS=http://localhost:5173

# Threat-intel cache TTL (ms)
INTEL_TTL_MS=300000
