# SolShield backend — environment template. Copy to `.env`.

# Comma-separated RPC endpoints (failover in order). Falls back to public mainnet.
SOLANA_RPC_URLS=

# Server
PORT=8787
HOST=0.0.0.0

# Comma-separated allowed CORS origins, or * for all (dev).
CORS_ORIGINS=http://localhost:5173

# --- MongoDB (optional) ---
# Connection string. If blank, the backend runs without persistence
# (scan log, analytics, reports, community intel are disabled).
MONGODB_URI=
MONGODB_DB=solshield

# --- Threat intel ---
INTEL_TTL_MS=300000
# Comma-separated remote JSON feed URLs to merge into intel on a timer.
INTEL_FEEDS=
INTEL_REFRESH_MS=600000

# --- Cache + rate limiting ---
SCAN_CACHE_TTL_MS=60000
RATE_MAX=120
RATE_WINDOW_MS=60000

# Admin key for protected endpoints (intel refresh). Blank disables them.
ADMIN_KEY=

# Comma-separated API keys. If set, /api/scan requires an x-api-key header.
# Leave blank for an open API (the demo frontend works without keys).
API_KEYS=
